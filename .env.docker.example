# DavaQ only. Copy to an untracked .env and fill in this service's configuration.
COMPOSE_FILE=docker-compose.server.yml
API_IMAGE=
DATABASE_URL=
REDIS_URL=redis://redis:6379
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CORS_ALLOWED_ORIGINS=https://davaq.anothermeai.app
PWA_ORIGIN=https://davaq.anothermeai.app
PWA_BASE_PATH=/app
EXPO_PUBLIC_API_BASE_URL=https://davaq.anothermeai.app
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=
DAVAQ_AI_MODEL=gpt-5-mini
DAVAQ_LEGACY_PERSONA_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@smileon.app
FIREBASE_SERVICE_ACCOUNT=
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PRIVATE_PREFIX=private
S3_PUBLIC_PREFIXES=public
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# iOS alert + PushKit delivery (server only; never include private keys in app builds).
APNS_KEY_ID=
APNS_TEAM_ID=B763M3724N
APNS_BUNDLE_ID=app.davaq.mobile
# PEM with newlines escaped as \n, stored securely in the DavaQ server environment.
APNS_PRIVATE_KEY=

# Shared TCGIndex catalog and photo-recognition integration
TCGINDEX_ORIGIN=https://tcgindex.org
TCG_DAVAQ_SHARED_KEY=
TCG_AI_MODEL=gpt-4o-mini

# AI collector group room (server only; provision migration 0048 before enabling)
COLLECTOR_LOUNGE_ENABLED=false
JEV_AI_API_KEY=
COLLECTOR_JEV_MODEL=jev-latest
COLLECTOR_CHAT_MODEL=gpt-5.4
COLLECTOR_REVIEW_MODEL=gpt-5.4
COLLECTOR_REPAIR_MODEL=gpt-5.4
COLLECTOR_VISION_MODEL=gpt-4o
# Apply 0051_collector_ai_budget.sql before enabling: all collector calls share USD 1/day (Asia/Seoul).

# Free shop pilot. Apply migration 0052 before enabling; off by default.
DAVAQ_SHOPS_ENABLED=false
