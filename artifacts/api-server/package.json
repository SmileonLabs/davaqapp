{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:shops": "vitest run src/lib/shop/shops.test.ts src/lib/pushTransports.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@clerk/backend": "^3.8.3",
    "@clerk/express": "^2.1.30",
    "@clerk/shared": "^4.20.0",
    "@google-cloud/storage": "^7.21.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "firebase-admin": "^14.0.0",
    "google-auth-library": "^10.7.0",
    "http-proxy-middleware": "^4.1.1",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.15.5",
    "neo4j-driver": "^6.2.0",
    "openai": "^6.44.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "viem": "^2.54.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.10"
  }
