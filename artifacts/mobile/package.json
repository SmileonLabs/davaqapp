    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "android": "expo run:android",
    "test:android-native": "node --experimental-strip-types --test lib/androidCallPolicy.test.mjs lib/callReliabilityEnvironment.test.mjs lib/apiBase.test.mjs lib/androidMessageNotifications.test.mjs lib/nativePushRegistrar.test.mjs && node --test plugins/withAndroidTelecom.test.js plugins/withAndroidUploadSigning.test.js"
