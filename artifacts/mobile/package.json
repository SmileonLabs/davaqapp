  "scripts": {
    "dev": "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "test:call-plugin": "node --test plugins/withCallForegroundService.test.js",
    "test:pwa-cache-policy": "node --test public/sw-cache-policy.test.js public/sw-push-owner-policy.test.js",
    "test:reliability": "node --experimental-strip-types --test lib/incomingCallDeadline.test.mjs lib/chatReadVisibility.test.mjs lib/chatOutboxWakeup.test.mjs lib/chatMessageReliability.test.mjs lib/chatOutboxStorageSweep.test.mjs lib/nativePushOwnerPolicy.test.mjs lib/realtimeConnectionPolicy.test.mjs lib/callToneController.test.ts lib/callAttemptPolicy.test.ts lib/callRecoveryPolicy.test.ts lib/callScreenAwake.test.ts lib/callPresentation.test.ts components/CallAcceptFlow.test.mjs components/GroupCallFlow.test.mjs components/CallCameraPreview.test.mjs lib/pushRegistrationCoordinator.test.ts && node --test public/sw-cache-policy.test.js public/sw-push-owner-policy.test.js",
    "verify:android-apk": "node scripts/verify-android-apk.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:native": "expo start --dev-client --localhost --port 8081",
    "native:doctor": "node scripts/native-doctor.mjs",
    "native:ios": "node scripts/native-doctor.mjs ios && expo run:ios",
    "native:android": "node scripts/native-doctor.mjs android && expo run:android",
    "native:prebuild": "expo prebuild --no-install",
    "test:native-config": "node --test scripts/native-config.test.cjs plugins/withSystemCalls.test.js",
    "ios:testflight": "node scripts/testflight-local.mjs",
    "ios:testflight:cloud": "node scripts/testflight.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:android-native": "node --experimental-strip-types --test lib/androidCallPolicy.test.mjs lib/callActionDelivery.test.mjs lib/headlessPushAuth.test.mjs lib/androidMessageNotifications.test.mjs lib/nativePushOwnerQueue.test.mjs lib/nativePushRegistrar.test.mjs && node --test plugins/withAndroidTelecom.test.js plugins/withAndroidUploadSigning.test.js",
    "android:play:local": "node scripts/build-play-local.mjs",
    "test:chat-notifications": "node --experimental-strip-types --test lib/chatNotificationPolicy.test.mjs lib/chatNotifications.test.mjs public/sw-chat-read.test.cjs",
    "test:chat-navigation": "node --test hooks/useInvertedChatListController.test.mjs components/GroupCreateScreenV2.test.mjs",
    "test:chat-flow": "node --experimental-strip-types --test hooks/useInvertedChatListController.test.mjs hooks/useReliableRoomMessages.test.mjs hooks/useChatPreload.test.mjs lib/chatLatestRefresh.test.mjs lib/chatResumeRefresh.test.mjs lib/chatEdgeBackPolicy.test.mjs lib/chatReadingPosition.test.mjs lib/chatChangeRecovery.test.mjs lib/chatAlbumPolicy.test.mjs",
    "test:android-update": "node --experimental-strip-types --test lib/androidUpdatePolicy.test.mjs && node --test plugins/withAndroidPlayUpdate.test.js",
    "test:exchange-feed": "node --experimental-strip-types --test hooks/useExchangeFeed.test.mjs lib/exchangeFeedPolicy.test.mjs lib/tcgRegistration.test.mjs components/tcg/ExchangeFeedScreen.test.mjs components/tcg/CardFeedFlow.test.mjs components/tcg/ExchangeRegistration.test.mjs components/tcg/Screens.registration.test.mjs components/tcg/ExchangeIcon.test.mjs components/tcg/OfferFlow.test.mjs components/tcg/Cards.first-load.test.mjs",
    "test:chat-interactions": "node --experimental-strip-types --test lib/chatInteractionPolicy.test.mjs components/chat/ChatRoomSheets.safety.test.mjs components/chat/SwipeToReply.test.mjs",
    "test:stickers": "node --experimental-strip-types --test lib/stickerPickerPolicy.test.mjs components/StickerPicker.test.mjs",
    "test:shops": "node --experimental-strip-types --test lib/shopWorkflow.test.mjs public/sw-shop-push.test.js public/sw-push-owner-policy.test.js",
    "test:shops:browser": "node tests/shop-browser.mjs"
  },
