{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "pnpm": "10.26.1",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "pnpm": "10.26.1",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://davaq.app",
        "EXPO_PUBLIC_DOMAIN": "davaq.app"
      }
    },
    "preview-arm": {
      "distribution": "internal",
      "environment": "preview",
      "pnpm": "10.26.1",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://davaq.app",
        "EXPO_PUBLIC_DOMAIN": "davaq.app"
      }
    },
    "preview-arm64": {
      "distribution": "internal",
      "environment": "preview",
      "pnpm": "10.26.1",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://davaq.app",
        "EXPO_PUBLIC_DOMAIN": "davaq.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "pnpm": "10.26.1",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://davaq.app",
        "EXPO_PUBLIC_DOMAIN": "davaq.app"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "ascAppId": "6821069081",
        "appleTeamId": "B763M3724N"
      }
    }
  }
}
