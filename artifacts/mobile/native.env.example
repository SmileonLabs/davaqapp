# Copy to artifacts/mobile/.env.local. Do not commit credentials.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Simulator can use localhost; physical devices need your computer's LAN IP or a dev server.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# Paths are relative to artifacts/mobile, or absolute EAS file-variable paths.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
EAS_PROJECT_ID=
# Optional for cloud builds only; local TestFlight builds do not need EAS_PROJECT_ID.
# Increase for each local TestFlight upload.
DAVAQ_IOS_BUILD_NUMBER=1
# Optional installed App Store profile name for app-only manual distribution signing.
DAVAQ_IOS_PROVISIONING_PROFILE=
