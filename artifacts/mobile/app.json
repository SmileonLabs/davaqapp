{
  "expo": {
    "name": "DavaQ",
    "slug": "davaq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/davaq/app-icon-v2.png",
    "scheme": "davaq",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/davaq/queue.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.davaq.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSMicrophoneUsageDescription": "음성 통화를 위해 마이크 접근 권한이 필요합니다.",
        "NSCameraUsageDescription": "카드 촬영·스캔과 영상통화를 위해 카메라 접근 권한이 필요합니다."
      },
      "bitcode": false,
      "buildNumber": "38"
    },
    "android": {
      "package": "app.davaq.mobile",
      "versionCode": 57,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/davaq/brand-foreground.png",
        "backgroundColor": "#000000",
        "monochromeImage": "./assets/images/davaq/brand-foreground.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ],
      "icon": "./assets/images/davaq/app-icon-v2.png"
    },
    "web": {
      "favicon": "./assets/images/davaq/app-icon-v2.png",
      "name": "DavaQ",
      "shortName": "DavaQ",
      "description": "DavaQ (다바꿔)",
      "backgroundColor": "#000000",
      "themeColor": "#000000",
      "lang": "ko",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://davaq.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "./plugins/withCallForegroundService",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "exclude": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF",
                "META-INF/**/OSGI-INF/MANIFEST.MF"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "17.0",
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging",
              "livekit-react-native-webrtc",
              "livekit-react-native"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "카드 직거래 지역을 설정하기 위해 현재 위치를 사용합니다."
        }
      ],
      "@react-native-firebase/messaging",
      "./plugins/withSystemCalls",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/davaq/queue.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {},
    "backgroundColor": "#000000"
  }
}
