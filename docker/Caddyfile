{
  auto_https off
}

:80 {
  handle /api/* {
    request_body {
      max_size 30MB
    }
    reverse_proxy app:8080 {
      header_up X-Forwarded-Proto https
      header_up X-Edge-Request-Id {http.request.uuid}
      header_down X-Edge-Request-Id {http.request.uuid}
    }
  }
  handle /app {
    redir * /app/ 308
  }
  @appAssets path /app/_expo/static/* /app/assets/* /app/favicon.ico
  handle @appAssets {
    root * /srv/app
    uri strip_prefix /app
    encode zstd gzip
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle_path /app/* {
    root * /srv/app
    encode zstd gzip
    header Cache-Control no-cache
    try_files {path} /index.html
    file_server
  }
  handle {
    root * /srv/landing
    encode zstd gzip
    try_files {path} /index.html
    file_server
  }
}
